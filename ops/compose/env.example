# Copy this file to .env beside compose.yml and set each value.
# The public domain of the relay. Its DNS A or AAAA record names this host.
SNAILFISH_DOMAIN=sync.example.net
# The email of the certificate account at Let's Encrypt.
SNAILFISH_ACME_EMAIL=admin@example.net
# The most stored change bytes of each space (default 256 MiB).
SNAILFISH_SPACE_BYTES=268435456
# The most spaces of each user.
SNAILFISH_MAX_SPACES=32
